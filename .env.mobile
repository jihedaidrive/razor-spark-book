# Mobile Testing Configuration
# Copy this to .env.local when testing push notifications on mobile devices

# API Configuration for Mobile Testing (using ngrok)
# Replace with your actual ngrok URLs
VITE_API_URL=https://your-backend-ngrok-url.ngrok.io

# Environment
VITE_ENVIRONMENT=development

# Debug Mode
VITE_DEBUG=true

# Instructions:
# 1. Start your backend: npm start (on port 3000)
# 2. Start ngrok for backend: ngrok http 3000
# 3. Update VITE_API_URL above with the ngrok HTTPS URL
# 4. Copy this file to .env.local
# 5. Restart your React dev server: npm run dev
# 6. Start ngrok for frontend: ngrok http 8080
# 7. Test on mobile using the frontend ngrok URL
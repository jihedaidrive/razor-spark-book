pipeline {
  agent any

  stages {
    stage('Checkout') {
      steps {
        git branch: 'main',
            url: 'https://github.com/jihedaidrive/razor-spark-book.git',
            credentialsId: 'github-token'
      }
    }

    stage('Install Dependencies') {
      steps {
        sh 'npm install'
      }
    }

    stage('Build Frontend') {
      steps {
        sh 'npm run build'
      }
    }

    stage('Deploy') {
      steps {
        sh '''
        rm -rf /var/www/html/*
        cp -r build/* /var/www/html/
        '''
      }
    }
  }
}
